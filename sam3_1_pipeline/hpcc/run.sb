#!/bin/bash --login
# Run any script of this folder as a GPU batch job on the MSU HPCC. Submit it from the
# sam3_1_pipeline folder:
#
#    cd ~/Capstone-MSU_Fruit/sam3_1_pipeline
#    sbatch hpcc/run.sb run.py clips
#    sbatch hpcc/run.sb run.py video ../data/videos/row3.mp4
#    sbatch --time=04:00:00 hpcc/run.sb finetune.py --run grapes_v1
#
# Everything after `run.sb` is run as `python <script> <arguments>`. The defaults below
# can be overridden on the sbatch line. The log is sam3_1-<job id>.out in this folder;
# `squeue --me` shows the job and `scancel <job id>` cancels it.
#
#SBATCH --job-name=sam3_1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=a100:1
#SBATCH --mem=48G
#SBATCH --time=02:00:00
#SBATCH --output=%x-%j.out

# Stop at the first command that fails.
set -eo pipefail
CODE_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [ ! -f "$CODE_DIR/run.py" ]; then
    echo "Submit from the sam3_1_pipeline folder: cd" \
        "~/Capstone-MSU_Fruit/sam3_1_pipeline && sbatch hpcc/run.sb run.py ..." >&2
    exit 1
fi
SAM31_ENV_DIR="${SAM31_ENV_DIR:-$HOME/envs/fruit_sam3_1}"
module purge
module load Miniforge3
eval "$(conda shell.bash hook)"
conda activate "$SAM31_ENV_DIR"

# At most 8 CPU threads, unless set already: a development node stops a process after
# two hours of CPU time, and a thread on each of its cores uses that up in minutes.
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-$(n=$(nproc); echo $((n < 8 ? n : 8)))}"
export MKL_NUM_THREADS="${MKL_NUM_THREADS:-$OMP_NUM_THREADS}"
echo "job $SLURM_JOB_ID on $(hostname) · $(date)"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader || true
cd "$CODE_DIR"
echo "command: python $*"
python "$@"
