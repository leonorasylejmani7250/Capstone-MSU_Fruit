#!/bin/bash --login
# Run any script of this folder as a GPU batch job on the MSU HPCC. Submit from the sam3_pipeline folder:
#     cd ~/Capstone-MSU_Fruit/sam3_pipeline
#     sbatch hpcc/run.sb run.py clips                                        masks for the labelled val clips (zero-shot or fine-tuned)
#     sbatch hpcc/run.sb run.py video ../data/videos/row3.mp4 --seconds 60   overlay video and counts
#     sbatch --time=08:00:00 hpcc/run.sb finetune.py --run grapes_v1         fine-tune on our clips → model/sam3_grapes_v1.pt
# Everything after `run.sb` is run as `python <script> <args>`. Log: sam3-<job id>.out in this folder.
# Status: squeue --me   Cancel: scancel <job id>
#
#SBATCH --job-name=sam3
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gpus=a100:1
#SBATCH --mem=48G
#SBATCH --time=02:00:00
#SBATCH --output=%x-%j.out
set -eo pipefail
CODE_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [ ! -f "$CODE_DIR/run.py" ]; then
    echo "Submit from the sam3_pipeline folder: cd ~/Capstone-MSU_Fruit/sam3_pipeline && sbatch hpcc/run.sb run.py ..." >&2
    exit 1
fi
SAM3_ENV_DIR="${SAM3_ENV_DIR:-$HOME/envs/fruit_sam3}"     # its own name: ENV_DIR belongs to the SAM 2.1 scripts
module purge
module load Miniforge3
eval "$(conda shell.bash hook)"
conda activate "$SAM3_ENV_DIR"
echo "job $SLURM_JOB_ID on $(hostname) · $(date)"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader || true
cd "$CODE_DIR"
echo "command: python $*"
python "$@"
