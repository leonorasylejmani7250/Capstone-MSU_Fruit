#!/bin/bash --login
# Run run_sam3.py as a GPU batch job on the MSU HPCC (untested; modelled on sam2_pipeline/hpcc/run.sb).
# Submit from the sam3_pipeline folder:
#     cd ~/Capstone-MSU_Fruit/sam3_pipeline
#     sbatch hpcc/run.sb clips                                      masks for the labelled val clips
#     sbatch hpcc/run.sb video ../data/videos/row3.mp4 --seconds 60  overlay video and counts
# Everything after `run.sb` is passed to run_sam3.py. Log: sam3-<job id>.out in this folder.
#
#SBATCH --job-name=sam3
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus=a100:1
#SBATCH --mem=32G
#SBATCH --time=02:00:00
#SBATCH --output=%x-%j.out
set -eo pipefail
CODE_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [ ! -f "$CODE_DIR/run_sam3.py" ]; then
    echo "Submit from the sam3_pipeline folder: cd ~/Capstone-MSU_Fruit/sam3_pipeline && sbatch hpcc/run.sb ..." >&2
    exit 1
fi
ENV_DIR="${ENV_DIR:-$HOME/envs/fruit_sam3}"
module purge
module load Miniforge3
eval "$(conda shell.bash hook)"
conda activate "$ENV_DIR"
echo "job $SLURM_JOB_ID on $(hostname) · $(date)"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader || true
cd "$CODE_DIR"
python run_sam3.py "$@"
