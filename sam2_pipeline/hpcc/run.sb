#!/bin/bash --login
# Run any fruit.py command as a GPU batch job on the MSU HPCC. Submit it from the
# sam2_pipeline folder:
#
#    cd ~/Capstone-MSU_Fruit/sam2_pipeline
#    sbatch hpcc/run.sb train --run grapes_v1 --steps 3000
#    sbatch hpcc/run.sb evaluate
#    sbatch hpcc/run.sb video videos/row3.mp4
#
# Everything after `run.sb` is passed to fruit.py (`python fruit.py --help` lists the
# commands). The defaults below can be overridden on the sbatch line, for example
# `sbatch --gpus=v100:1 --time=02:00:00 hpcc/run.sb evaluate`. The log is fruit-<job
# id>.out in this folder; `squeue --me` shows the job and `scancel <job id>` cancels it.
#
# Any GPU type of the HPCC works: the pipeline sizes the training to the card it gets. A
# training run that hits the time limit resumes when the same command is submitted again
# on the same GPU type.
#
#SBATCH --job-name=fruit
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --gpus=a100:1
#SBATCH --mem=32G
#SBATCH --time=04:00:00
#SBATCH --output=%x-%j.out

# Stop at the first command that fails.
set -eo pipefail
CODE_DIR="${SLURM_SUBMIT_DIR:-$(pwd)}"
if [ ! -f "$CODE_DIR/fruit.py" ]; then
    echo "Submit from the sam2_pipeline folder (the one with fruit.py):" >&2
    echo "    cd ~/Capstone-MSU_Fruit/sam2_pipeline && sbatch hpcc/run.sb ..." >&2
    exit 1
fi
source "$CODE_DIR/hpcc/activate.sh"

echo "job $SLURM_JOB_ID on $(hostname) · $(date)"
nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv,noheader || true
echo "command: python fruit.py $*"

# Relative paths typed on the command line (configs/…, exports/…) mean the folder the
# job was submitted from.
export FRUIT_CALLER_DIR="$CODE_DIR"

# The job runs where setup_env.sh put the detector weights.
cd "$FRUIT_BASE/weights"
python "$CODE_DIR/fruit.py" "$@"

# ICER's job summary: time, memory and GPU use.
command -v js >/dev/null && js -j "$SLURM_JOB_ID" || true
