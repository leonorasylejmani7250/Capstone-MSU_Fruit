# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Python environments: sam2_pipeline/envs (conda), yolo26_pipeline/.venv, sam3_pipeline/.venv
envs/
.venv/
venv/
env/

# Jupyter, editors, operating systems
.ipynb_checkpoints/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Secrets
.env
.env.*
*.key

# data/: everything the pipelines read and write (data/README.md). In git: the public WGISD dataset
# (data/wgisd, data/wgisd_yolo) and the archived October YOLO11 run (data/results/yolo11). Not in git:
# the partner's videos, our labelled clips, predictions, training runs, fine-tuned SAM 2.1 weights,
# the demo's output, and the results the scripts write (data/results/*). To keep a result for the
# report, copy its numbers into a README or add the file with `git add -f`.
data/videos/
data/dataset/
data/predictions/
data/models/
data/runs/
data/demo/
data/*_demo/
data/count_test/
data/yolo_dataset/
data/frames_to_label/
data/results/*
!data/results/yolo11/
*.cache

# Model weights. Each pipeline ships its model in <pipeline>/model/: YOLO26's best.pt is small and
# committed; SAM 2.1 weights are too big for GitHub and come from a GitHub Release instead
# (sam2_pipeline/model/README.md). Every other .pt is a download or a training artifact.
*.pt
*.pth
*.ckpt
*.onnx
!yolo26_pipeline/model/best.pt
!data/results/yolo11/best.pt

# Video files, wherever they are made
*.mp4
*.mov
*.avi
*.mkv

# Logs and temporary files (fruit-<job>.out: HPCC job logs in sam2_pipeline/)
*.log
*.tmp
*.out
